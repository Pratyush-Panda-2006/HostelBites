# ==============================================================================
# HostelBites Environment Template
# Safe to commit to GitHub.
# Copy this file to .env and insert your real API credentials:
#   cp .env.example .env
# ==============================================================================

# Groq API Key (for Gemma 2 promo copywriting) - https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs API Key (for George Turbo v2.5 voice brief) - https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: PriorLabs TabPFN Token (if using authenticated TabPFN cloud weights)
TABPFN_TOKEN=your_tabpfn_token_here

# Server Port
PORT=8000
