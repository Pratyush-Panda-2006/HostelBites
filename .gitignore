# ==============================================================================
# Git Ignore Rules for HostelBites
# ==============================================================================

# Environment & Secrets (NEVER push actual credentials)
.env
.env.local
.env.*.local
*.env
!.env.example

# Python cache & build
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Vercel & Deployment artifacts
.vercel
